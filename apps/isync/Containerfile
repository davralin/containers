ARG VERSION
ARG DIGEST
FROM debian:${VERSION}-slim@${DIGEST}

RUN groupadd -g 1000 group && \
    useradd -m -u 1000 -g group user

RUN \
  /usr/bin/apt-get -y update && \
  /usr/bin/apt-get -y install --no-install-recommends \
    ca-certificates \
    isync && \
  /usr/bin/rm -rf /var/lib/apt/lists/*

HEALTHCHECK NONE

USER user:group
