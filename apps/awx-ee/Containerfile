ARG VERSION
ARG DIGEST
FROM quay.io/ansible/awx-ee:${VERSION}@${DIGEST}
USER root
RUN dnf install -y \
  jq	\
  rhel-system-roles \
  rsync \
  python-ldap

RUN ansible-galaxy collection install -p /usr/share/ansible/collections \
    ansibleguy.opnsense \
    awx.awx \
    ansible.posix \
    community.crypto \
    community.general \
    community.windows \
    containers.podman

HEALTHCHECK NONE

USER 1000
