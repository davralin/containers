ARG VERSION
ARG DIGEST
FROM debian:${VERSION}-slim@${DIGEST}

RUN \
  /usr/bin/apt-get -y update && \
  /usr/bin/apt-get -y install --no-install-recommends \
    ca-certificates \
    calibre \
    coreutils \
    curl \
    e2fsprogs \
    ffmpeg \
    flac \
    file \
    git-core \
    jq \
    less \
    mkvtoolnix \
    nano \
    nmap \
    procps \
    rename \
    rsync \
    shntool \
    silversearcher-ag \
    sqlite3 \
    tar \
    tmux \
    unzip \
    vim \
    wget && \
  /usr/bin/rm -rf /var/lib/apt/lists/*

COPY sleeper /usr/local/bin/sleeper
COPY longsleep /usr/local/bin/longsleep

HEALTHCHECK NONE

ENTRYPOINT    ["sh", "-c"]
CMD           ["trap : TERM INT; sleep infinity & wait"]
